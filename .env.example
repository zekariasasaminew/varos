# VAROS Environment Configuration
# Copy this file to .env and fill in your values

# --- Required: LLM (choose one) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here  # fallback

# --- Required: NCBI (free, increases rate limits) ---
NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=your_ncbi_api_key_here   # get free at: https://www.ncbi.nlm.nih.gov/account/

# --- Optional: OMIM (free for research) ---
OMIM_API_KEY=your_omim_api_key_here   # request at: https://www.omim.org/api

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...         # get at: https://dashboard.stripe.com/apikeys
STRIPE_WEBHOOK_SECRET=whsec_...       # from: https://dashboard.stripe.com/webhooks
STRIPE_STARTER_PRICE_ID=price_...     # Starter plan price ID from Stripe dashboard
STRIPE_PRO_PRICE_ID=price_...         # Pro plan price ID from Stripe dashboard

# --- Email (SendGrid) ---
SENDGRID_API_KEY=SG....               # get at: https://app.sendgrid.com/settings/api_keys
SENDGRID_FROM_EMAIL=alerts@varos.io   # must be verified sender in SendGrid

# --- Database ---
DATABASE_URL=sqlite:///./varos.db     # SQLite for local dev
# DATABASE_URL=postgresql://user:pass@localhost:5432/varos  # production

# --- App settings ---
VAROS_ENV=development       # development | production
VAROS_LOG_LEVEL=INFO
VAROS_LLM_MODEL=claude-sonnet-4-6   # or gpt-4o
SECRET_KEY=change-me-in-production  # used for session signing

